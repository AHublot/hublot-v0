{
  "name": "hublot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
    "start": "python3 -m http.server 8080",
    "preview": "node tools/build-preview.mjs",
    "serve": "node --disable-warning=ExperimentalWarning server/server.js",
    "admin": "node --disable-warning=ExperimentalWarning server/cli.js"
  },
  "engines": {
    "node": ">=22.13"
  }
}
